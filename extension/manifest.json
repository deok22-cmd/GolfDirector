{
  "manifest_version": 3,
  "name": "골프총무 (Golf Director)",
  "version": "0.2.0",
  "description": "해외 골프 여행 상품(텍스트·이미지·PDF)을 긁어와 AI로 비용 매트릭스 JSON으로 정제해주는 비서. 우측 사이드패널에서 동작합니다.",
  "permissions": ["sidePanel", "activeTab", "scripting", "storage", "contextMenus"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "골프총무 사이드패널 열기"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
