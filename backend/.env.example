# 골프총무 백엔드 환경변수 — 이 파일을 .env 로 복사해서 채우세요.
# (.env 는 git에 올라가지 않습니다)

# 로그인 토큰(JWT) 서명 키 — 아무 긴 무작위 문자열. 배포 시 반드시 강력하게!
JWT_SECRET=please-change-this-to-a-long-random-string

# 서버 포트 (기본 8787)
PORT=8787

# (선택) 견적서 AI 자동입력 기능을 쓸 때만 필요 — Anthropic API 키
# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=
